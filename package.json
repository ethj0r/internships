{
  "name": "sietch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal internship discovery, matching, CV tailoring and application tracker on Cloudflare Workers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts --env-file .dev.vars.example --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply internships --local",
    "db:migrate:remote": "wrangler d1 migrations apply internships --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "diff": "^8.0.2",
    "dompurify": "^3.2.6",
    "hono": "^4.9.0",
    "marked": "^16.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.30.0"
  }
}
