# Copy to .dev.vars for local development. Never commit .dev.vars.
# In production set these with `npx wrangler secret put <NAME>`.

# Password for the single owner account.
APP_PASSWORD=change-me

# Random string (32+ chars) used to sign session cookies.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional. Unlocks the NVIDIA options in the model picker (config/models.json): GLM-5.3-Flash and GLM-5.3 on
# NVIDIA's free API. Sign in at https://build.nvidia.com, then "Get API Key" (starts with nvapi-).
# Without it, only Workers AI models are offered.
# LLM_API_KEY=

# Optional, paid. Unlocks the Claude option in the model picker.
# ANTHROPIC_API_KEY=
