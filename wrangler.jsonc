{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "internships",
  // Personal Cloudflare account. Deploys fail rather than land in another account.
  "account_id": "14422e9f56eff5e77f6ec8f261191e53",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The React SPA is served as static assets; only /api/* runs the Worker first.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "internships",
      "database_id": "ef295b91-bd57-4334-a194-8672e6ea6fa0",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI: CV file → Markdown conversion, embeddings, the default model (gpt-oss-120b) and the fallback for
  // every other option in config/models.json.
  "ai": { "binding": "AI", "remote": true },

  // Brute-force protection for the single-owner login.
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "triggers": {
    // Hourly: continues or starts a refresh cycle (a new one only when REFRESH_INTERVAL_HOURS have passed since the
    // last one started; see worker/discovery/refresh.ts). Daily 07:00 UTC: deadline reminders.
    "crons": ["0 * * * *", "0 7 * * *"]
  },

  "vars": {
    // Default model for analysis and writing: an option id from config/models.json. Can be changed per document in
    // the app. Options that need a key (NVIDIA: LLM_API_KEY, Claude: ANTHROPIC_API_KEY) appear once it's set.
    "AI_MODEL": "workers-gpt-oss",
    // Workers AI fallbacks for every option, and the models behind "workers-gpt-oss".
    "WORKERS_AI_STRONG_MODEL": "@cf/openai/gpt-oss-120b",
    "WORKERS_AI_FAST_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "REFRESH_INTERVAL_HOURS": "72",
    "DISCOVERY_SOURCES_PER_RUN": "8",
    "DISCOVERY_MAX_DETAIL_FETCHES": "25",
    // Eligibility classifications by the fast model per cron run.
    "ELIGIBILITY_MODEL_CALLS_PER_RUN": "20"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
