{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "internships",
  // Personal Cloudflare account. Deploys fail rather than land in another account.
  "account_id": "14422e9f56eff5e77f6ec8f261191e53",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The React SPA is served as static assets; only /api/* runs the Worker first.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "internships",
      "database_id": "ef295b91-bd57-4334-a194-8672e6ea6fa0",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI: CV file → Markdown conversion, and the default LLM when no ANTHROPIC_API_KEY is set.
  "ai": { "binding": "AI", "remote": true },

  // Brute-force protection for the single-owner login.
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "triggers": {
    // Hourly: discovery (round-robin over sources). Daily 07:00 UTC: deadline reminders.
    "crons": ["0 * * * *", "0 7 * * *"]
  },

  "vars": {
    "AI_PROVIDER": "auto",
    "DISCOVERY_SOURCES_PER_RUN": "6",
    "DISCOVERY_MAX_DETAIL_FETCHES": "25"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
